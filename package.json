    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": ".\\node_modules\\.bin\\typeorm-ts-node-commonjs.cmd migration:generate -d src/data-source.ts src/migrations/Migration",
    "migration:run": ".\\node_modules\\.bin\\typeorm-ts-node-commonjs.cmd migration:run -d src/data-source.ts",
    "migration:revert": ".\\node_modules\\.bin\\typeorm-ts-node-commonjs.cmd migration:revert -d src/data-source.ts",
    "seed": "ts-node src/seeds/seed-all.ts",
    "seed:undo": "ts-node src/seeds/undo-seed.ts",
    "seed:undo:dry-run": "ts-node src/seeds/undo-seed.ts --dry-run"
  },
